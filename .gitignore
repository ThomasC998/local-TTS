# The model checkpoints. Several gigabytes each, they are not ours, and
# `python download_model.py` fetches whichever one this machine needs. See
# MODELS.md.
chkpt-mlx-int8/
chkpt-breeze-tts-2/
chkpt-full/
chkpt-mlx-int4/

# The saved voice library: recordings of real people, and the profiles built
# from them. Personal data, and nothing here can be reconstructed from source --
# so it is kept on this machine and never in a commit. Back it up separately.
voices/

# Local configuration: the language-model provider, API keys, the checkpoint
# path. Per-machine by definition, and .env.example is what belongs in the repo.
.env

# System-speech settings and the utterance archive: machine-local state.
state/

# Generated audio, and the log the server rewrites on every run.
outputs/
server.log
*.wav

# Virtual environments.
.venv/
venv/
env/

# Working notes and the reference documents this was built from. The README and
# MODELS.md are the documentation; these are drafts and scratch, and they are
# kept locally rather than published.
API.md
AUDIO_PLAYBACK.md
breezeTTS2 docs.md
GCLOUD_VERTEX_LLM_USAGE_GUIDE copy.md

# Build artefacts and Finder droppings: derived, and they churn on every run.
__pycache__/
*.pyc
.DS_Store
Thumbs.db
