# Copy to .env and edit. Every setting here has a default, so a machine that is
# happy with the defaults does not need this file at all.
#
# The same file works on macOS and Windows: it is read with python-dotenv,
# which accepts either line ending, and nothing in it is a path with a
# separator in it that would have to differ.

# ---------------------------------------------------------------------------
# Language model
#
# Which service prepares copied text for reading aloud. Four are built in:
#
#   gemini           Google Gemini. One API key, no SDK to install.
#                    Key: https://aistudio.google.com/apikey
#   openrouter_free  OpenRouter, on whichever model is free right now. The
#                    catalogue is checked at start-up, so nothing goes stale.
#                    Key: https://openrouter.ai/keys
#   openrouter_paid  OpenRouter, on a model you name below. Billed to the key.
#   vertex           Google Vertex AI. No key -- it uses Application Default
#                    Credentials, so it needs the gcloud SDK and
#                    `gcloud auth application-default login` once. The best
#                    option on a machine that already has that set up.
#
# Left unset, the first provider with a credential present is used, API keys
# before Vertex.
# ---------------------------------------------------------------------------
BREEZE_LLM_PROVIDER=gemini

GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Pin the model, per provider. Each has a sensible default; these override it.
# BREEZE_GEMINI_MODEL=gemini-2.5-flash-lite
# BREEZE_OPENROUTER_MODEL=google/gemini-2.0-flash-lite-001
# BREEZE_LLM_MODEL=gemini-3.5-flash-lite

# For openrouter_free only: substrings to prefer when several models are free,
# tried in order. Without this the free model with the longest context wins.
#   python -m llm_providers.openrouter --list-free
# BREEZE_OPENROUTER_PREFER=llama,qwen

# Vertex only. The project is also read from `gcloud config get-value project`
# and from the ADC file, so this is only needed when those disagree.
# GOOGLE_CLOUD_PROJECT=your-project-id
# BREEZE_VERTEX_LOCATION=global

# ---------------------------------------------------------------------------
# Speech engine
#
# The backend is chosen automatically -- MLX on Apple Silicon, PyTorch on an
# NVIDIA GPU -- and each looks for its own checkpoint directory, so BREEZE_MODEL
# is only needed if yours is somewhere else. See MODELS.md for what to download.
# ---------------------------------------------------------------------------
# BREEZE_BACKEND=mlx
# BREEZE_MODEL=./chkpt-mlx-int8

# Where the codec runs. "auto" puts it on the same accelerator as the model.
BREEZE_AUDIO_DEVICE=auto

# Windows/CUDA only, and only for the BF16 checkpoint: BF16 is native on RTX
# 30-series and newer, so set float16 on an older card where it is emulated.
# The INT8 checkpoint ignores this -- its unquantized weights have to match what
# its quantized ones dequantize into, so it uses its own dtype.
# BREEZE_TORCH_DTYPE=bfloat16
# BREEZE_TORCH_DEVICE=auto

# ---------------------------------------------------------------------------
# Reading screenshots sent from the phone
#
# A screenshot goes to a local multimodal model, which is asked for the article
# and not the clock, the tab bar or the buttons. Anything speaking the OpenAI
# chat-completions shape works; LM Studio's server in its default place is what
# these point at. With nothing loaded, macOS's own text recognition reads the
# screenshot instead -- accurately, but including the clock.
# ---------------------------------------------------------------------------
# BREEZE_VISION_BASE_URL=http://127.0.0.1:1234/v1
# BREEZE_VISION_MODEL=qwen2.5-vl-7b-instruct
# BREEZE_VISION_ENABLED=1
